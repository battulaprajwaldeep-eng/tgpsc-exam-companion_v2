{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tgpsc-exam-companion-v2",
  "main": "./worker.js",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/hf-model/*",
      "/onnxruntime/*"
    ]
  },
  "previews": {}
}
